  steps:
  - instructionText: "Grab the LED \n\nPlace its long leg in Row 2 and its short
      leg in Row 1."
    targetSocket: {fileID: 121961714}
    interactionObject: {fileID: 0}
    stepImage: {fileID: 1145775903}
    stepArrows:
    - {fileID: 726204492}
  - instructionText: 'Grab the resistor


      Place it in Row 1, connecting the
      LED to the circuit.'
    targetSocket: {fileID: 8400001703700535822}
    interactionObject: {fileID: 0}
    stepImage: {fileID: 1179721843}
    stepArrows:
    - {fileID: 238080835}
  - instructionText: 'Connect the wire


      Connect the positive side (+) of the
      circuit to the LED.'
    targetSocket: {fileID: 8400001703700535821}
    interactionObject: {fileID: 0}
    stepImage: {fileID: 1563866383}
    stepArrows:
    - {fileID: 1681261074}
    - {fileID: 171422217}
  - instructionText: "Connect the second wire\n\nConnect the negative side (\u2212)
      back to complete the circuit."
    targetSocket: {fileID: 1801844700}
    interactionObject: {fileID: 0}
    stepImage: {fileID: 457805418}
    stepArrows:
    - {fileID: 119421405}
    - {fileID: 814641727}
  - instructionText: Press the Power Button Turn on the circuit and watch the LED
      light up.
    targetSocket: {fileID: 0}
    interactionObject: {fileID: 1836415390}
    stepImage: {fileID: 0}
    stepArrows:
    - {fileID: 911506747}
