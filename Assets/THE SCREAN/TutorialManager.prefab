    stepCanvas: {fileID: 0}
    stepTextUI: {fileID: 0}
    textContent: 'Welcome to the Virtual Lab! You will see two main options: Information
      to explore detailed properties of elements, and Reactions to view available
      chemical reactions and begin your experiment.'
    stepAudio: {fileID: 8300000, guid: 9f975130cffaf1541bcc0105ec6c7501, type: 3}
    canvasGroup: {fileID: 0}
  - arrowGroup: {fileID: 0}
    wordHighlights:
