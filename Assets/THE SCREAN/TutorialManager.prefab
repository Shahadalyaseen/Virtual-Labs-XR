      delayToEnable: 3
      blinkOnDuration: 0.3
      blinkOffDuration: 0.3
      blinkCount: 5
    stepCanvas: {fileID: 0}
    stepTextUI: {fileID: 0}
    textContent: In front of you is the interactive Periodic Table, containing chemical
      elements categorized by their groups. By selecting any element, you can explore
      its detailed properties and atomic structure.
    stepAudio: {fileID: 8300000, guid: 27a5d8b1df4470347bddcdad0e5e0c7d, type: 3}
    canvasGroup: {fileID: 0}
  - arrowGroup: {fileID: 0}
    wordHighlights:
    - highlightObject: {fileID: 0}
      delayToEnable: 2
      blinkOnDuration: 0.3
      blinkOffDuration: 0.3
      blinkCount: 5
    stepCanvas: {fileID: 0}
    stepTextUI: {fileID: 0}
    textContent: This is the Mixing Station and the reaction tubes below! Once you
      select the required elements, they will be placed here and mixed to display
      the resulting chemical reaction live. You can also view and check the available
      reactions anytime from the Menu.
    stepAudio: {fileID: 8300000, guid: 6a6d70db447125f498fa6a424357a803, type: 3}
    canvasGroup: {fileID: 0}
